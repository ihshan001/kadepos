<?xml version="1.0" encoding="utf-8"?>
<!--
  Arro-POS mark: a modern flat checkout "A". Adaptive icon safe zone is the
  middle 66dp of the 108dp canvas, so all artwork sits between 21dp and 87dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left leg of the A -->
    <path
        android:pathData="M28,85 L52,22 L60,22 L38,85 Z"
        android:fillColor="#FFFFFF" />

    <!-- Right leg of the A -->
    <path
        android:pathData="M80,85 L56,22 L48,22 L70,85 Z"
        android:fillColor="#FFFFFF" />

    <!-- Gold crossbar (checkout line) -->
    <path
        android:pathData="M36,60 L72,60 L72,69 L36,69 Z"
        android:fillColor="#EAC34D" />

    <!-- Dark-gold highlight on the left leg -->
    <path
        android:pathData="M35,48 L40,48 L32,68 L28,68 Z"
        android:fillColor="#B8860B" />
</vector>
